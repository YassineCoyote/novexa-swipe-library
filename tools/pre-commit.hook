#!/bin/bash
# Rebuild the operator's visual browser from CONCEPT_LIBRARY.md on every commit, so it can never lag the library.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 tools/build_browser.py || { echo "build_browser.py failed — commit aborted"; exit 1; }
git add SwipeLibrary.html SwipeLibrary_recap.csv
D="$HOME/Desktop/Claude - Product HQ Docs for knowledge tab Universal/Same for all projects"
cp -f SwipeLibrary.html "$D/ProductHQ_SwipeLibrary.html" 2>/dev/null
cp -f SwipeLibrary_recap.csv "$D/ProductHQ_SwipeLibrary_recap.csv" 2>/dev/null
