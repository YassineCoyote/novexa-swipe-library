#!/bin/bash
# Rebuild the operator's visual browser from CONCEPT_LIBRARY.md on every commit, so it can never lag the library.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 tools/build_browser.py || { echo "build_browser.py failed — commit aborted"; exit 1; }
git add SwipeLibrary.html
cp -f SwipeLibrary.html "$HOME/Desktop/Claude - Product HQ Docs for knowledge tab Universal/Same for all projects/ProductHQ_SwipeLibrary.html" 2>/dev/null
